#!/system/bin/sh

PM="/system/bin/pm"
DATA_DIR="/data/adb/pixelfirewall"
CACHE="$DATA_DIR/apps.json"
TMP="$DATA_DIR/apps.json.$$"
USERS="$DATA_DIR/users.$$"
LABELS="$DATA_DIR/labels.conf"

trap 'rm -f "$TMP" "$USERS" "$DATA_DIR"/systems.* "$DATA_DIR"/packages.* "$DATA_DIR"/apps.[0-9]*' EXIT

mkdir -p "$DATA_DIR" || exit 1

"$PM" list users 2>/dev/null |
/system/bin/sed -n 's/.*UserInfo{\([0-9][0-9]*\):\([^:}]*\):.*/\1|\2/p' |
/system/bin/sort -t'|' -k1,1n -u > "$USERS" || exit 1

printf '{"status":"OK","profiles":[' > "$TMP"

first=1
while IFS='|' read -r user name
do
    [ -z "$user" ] && continue

    [ "$first" -eq 0 ] && printf ',' >> "$TMP"

    printf '{"id":"%s","name":"%s"}' "$user" "$name" >> "$TMP"

    first=0
done < "$USERS"

printf '],"apps":[' >> "$TMP"

first=1

for user in $(/system/bin/cut -d'|' -f1 "$USERS")
do
    [ -z "$user" ] && continue

    SYSTEMS="$DATA_DIR/systems.$user"
    PKGS="$DATA_DIR/packages.$user"
    OUT="$DATA_DIR/apps.$user"

    "$PM" list packages -s --user "$user" 2>/dev/null |
    /system/bin/sed 's/^package://' > "$SYSTEMS"

    "$PM" list packages --user "$user" -U 2>/dev/null | /system/bin/sed -n 's/^package:\([^ ]*\) uid:\([0-9]*\)$/\1|\2/p' | /system/bin/sed "s/$/|$user/" > "$PKGS"

    /system/bin/awk -F'|' '
        BEGIN {
            first = 1

            while ((getline line < ARGV[3]) > 0) {
                split(line, a, "=")
                if (a[1] != "")
                    label[a[1]] = substr(line, length(a[1]) + 2)
            }

            close(ARGV[3])
        }

        NR == FNR {
            sys_pkg[$0] = 1
            next
        }

        {
            pkg = $1
            uid = $2
            appuser = $3

            if (uid == "0" || uid == "1000" || uid == "1001" || uid == "2000")
                next

            if (pkg in sys_pkg)
                is_system = "true"
            else
                is_system = "false"

            if (pkg in label) {
                name = label[pkg]
            } else {
                n = split(pkg, parts, ".")
                name = parts[n]
                gsub(/[_-]/, " ", name)
                name = toupper(substr(name, 1, 1)) substr(name, 2)
            }

            if (!first)
                printf ","

            printf "{\"user\":\"%s\",\"uid\":\"%s\",\"pkg\":\"%s\",\"name\":\"%s\",\"system\":%s}", appuser, uid, pkg, name, is_system

            first = 0
        }
    ' "$SYSTEMS" "$PKGS" "$LABELS" > "$OUT"

    if [ -s "$OUT" ]; then
        if [ "$first" -eq 0 ]; then
            printf ',' >> "$TMP"
        fi

        cat "$OUT" >> "$TMP"
        first=0
    fi
done

printf ']}\n' >> "$TMP"

mv -f "$TMP" "$CACHE" || exit 1

chmod 644 "$CACHE"

echo "Apps cache refreshed"
